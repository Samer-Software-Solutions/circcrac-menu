# Supabase project base URL, for example https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key from the Supabase project's API settings
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional fixed public origin for printable QR codes, e.g. https://menu.example.com
# If omitted, the QR screen uses the current request origin.
SITE_URL=
